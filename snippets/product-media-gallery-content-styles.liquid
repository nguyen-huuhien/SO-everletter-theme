{%- doc -%}
  Product media gallery content styles extracted into a standalone snippet.

  @example
  {% render 'product-media-gallery-content-styles' %}
{%- enddoc -%}

{% stylesheet %}
  media-gallery:where(.media-gallery--grid) .media-gallery__grid {
    display: none;
  }

  media-gallery.media-gallery--grid .media-gallery__grid .product-media-container {
    /* Needed for safari to stretch to full grid height */
    height: 100%;
  }

  @media screen and (min-width: 750px) {
    .media-gallery--two-column .media-gallery__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    /* Display grid view as a carousel on mobile, grid on desktop */
    media-gallery:is(.media-gallery--grid) slideshow-component {
      display: none;
    }

    media-gallery:where(.media-gallery--grid) .media-gallery__grid {
      display: grid;
    }
  }

  .product-media-container__zoom-button {
    position: absolute;
    width: 100%;
    height: 100%;
    z-index: var(--layer-flat);
    cursor: zoom-in;
    background-color: transparent;

    &:hover {
      background-color: transparent;
    }
  }

  slideshow-slide.product-media-container--tallest {
    content-visibility: visible;
  }

  .product-media__drag-zoom-wrapper {
    aspect-ratio: inherit;
    min-height: inherit;
    min-width: inherit;
    display: inherit;
    flex: inherit;
  }

  .media-gallery__mobile-controls {
    grid-area: auto;
  }

  .product-media-container--zoomable.product-media-container--image {
    cursor: zoom-in;
  }

  /* Product Media Gallery Carousel & Thumbnail Navigation */
  .media-gallery--carousel {
    max-width: var(--gallery-max-width, 620px);
    width: 100%;
    margin-inline: 0 auto;
  }

  @media screen and (max-width: 749px) {
    .media-gallery--carousel {
      margin-inline: auto;
    }
  }

  .media-gallery--carousel slideshow-component {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm, 12px);
    width: 100%;
  }

  .media-gallery--carousel slideshow-container {
    border-radius: var(--media-radius, 20px);
    overflow: hidden;
    position: relative;
    width: 100%;
    max-width: var(--gallery-max-width, 620px);
  }

  .media-gallery--carousel slideshow-container img,
  .media-gallery--carousel slideshow-container video,
  .media-gallery--carousel slideshow-container model-viewer {
    border-radius: var(--media-radius, 20px);
  }

  slideshow-controls[thumbnails][pagination-position='center'] {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: 100%;
    margin-top: 12px;
    margin-inline: auto;
  }

  slideshow-controls[thumbnails][pagination-position='center'] .slideshow-controls__arrows {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    height: auto;
  }

  slideshow-controls[thumbnails][pagination-position='center'] .slideshow-controls__arrows button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    color: var(--color-foreground, currentColor);
    opacity: 0.7;
    cursor: pointer;
    background: transparent;
    border: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  slideshow-controls[thumbnails][pagination-position='center'] .slideshow-controls__arrows button:hover {
    opacity: 1;
  }

  slideshow-controls[thumbnails][pagination-position='center'] .slideshow-controls__arrows button[disabled] {
    opacity: 0.2;
    cursor: not-allowed;
  }

  slideshow-controls[thumbnails][pagination-position='center'] .slideshow-controls__thumbnails-container {
    flex: 0 1 auto;
    width: auto;
    max-width: calc(100% - 80px);
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  slideshow-controls[thumbnails][pagination-position='center'] .slideshow-controls__thumbnails-container::-webkit-scrollbar {
    display: none;
  }

  slideshow-controls[thumbnails][pagination-position='center'] .slideshow-controls__thumbnails {
    display: inline-flex;
    gap: 12px;
    padding: 4px;
    margin: 0 auto;
    align-items: center;
  }

  slideshow-controls[thumbnails][pagination-position='center'] .slideshow-controls__thumbnail {
    border-radius: var(--thumbnail-radius, 14px);
    width: clamp(52px, 14vw, var(--thumbnail-width, 72px));
    height: auto;
    aspect-ratio: var(--aspect-ratio, 1);
    flex-shrink: 0;
    cursor: pointer;
    overflow: hidden;
    padding: 0;
    background: transparent;
    border: 1px solid transparent;
    box-sizing: border-box;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }

  slideshow-controls[thumbnails][pagination-position='center'] .slideshow-controls__thumbnail img {
    border-radius: var(--thumbnail-radius, 14px);
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  slideshow-controls[thumbnails][pagination-position='center'] .slideshow-controls__thumbnail:is([aria-selected='true']) {
    box-shadow: 0 0 0 2px var(--color-foreground, #000);
    outline: none;
    border-color: transparent;
  }
{% endstylesheet %}
