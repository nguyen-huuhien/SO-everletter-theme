{%- doc -%}
  Variant picker styles consolidated into a single snippet for reliable CSS subsetting.
  Rendered from both the variant-main-picker snippet (product pages, where the picker
  originally renders) and from the product-card-related blocks and sections that can
  spawn a quick-add modal (collection/search pages), so the dropdown variant picker
  styles are available when the quick-add modal injects a variant picker via fetched
  product page HTML.

  @example
  {% render 'variant-picker-styles' %}
{%- enddoc -%}

{% stylesheet %}
  /* Variant picker container styles - unique to main variant picker */
  .variant-picker {
    width: 100%;
  }

  .variant-picker__form {
    width: 100%;
  }

  .variant-picker[data-shopify-visual-preview] {
    min-width: 300px;
    padding-inline-start: max(4px, var(--padding-inline-start));
  }

  /* Dropdown variant option styles */
  .variant-option__select-wrapper {
    display: flex;
    position: relative;
    border: var(--style-border-width-inputs) solid var(--color-variant-border);
    border-radius: var(--style-border-radius-inputs);
    align-items: center;
    margin-top: var(--margin-2xs);
    overflow: clip;
    color: var(--color-variant-text);
  }

  .variant-option__select-wrapper:has(.swatch) {
    --variant-picker-swatch-width: 20px;
    --variant-picker-swatch-height: 20px;
  }

  .variant-option__select-wrapper:hover {
    border-color: var(--color-variant-hover-border);
    color: var(--color-variant-hover-text);
  }

  .variant-option__select-wrapper:hover .variant-option__select {
    background-color: var(--color-variant-hover-background);
  }

  .variant-option__select:focus-visible {
    outline: var(--focus-outline-width) solid currentcolor;
    outline-offset: var(--focus-outline-offset);
  }

  .variant-option__select {
    padding-block: var(--padding-md);
    padding-inline: var(--padding-lg) calc(var(--padding-lg) + var(--icon-size-2xs));
    appearance: none;
    background-color: var(--color-variant-background);
    color: inherit;
    border: 0;
    width: 100%;
    margin: 0;
    cursor: pointer;
  }

  .variant-option__select-wrapper .icon {
    position: absolute;
    right: var(--padding-md);
    top: 50%;
    transform: translateY(-50%);
    width: var(--icon-size-2xs);
    height: var(--icon-size-2xs);
    pointer-events: none;
  }

  .variant-option__select--has-swatch {
    padding-inline-start: calc((2 * var(--padding-sm)) + var(--variant-picker-swatch-width));
  }

  .variant-option__select-wrapper .swatch {
    position: absolute;
    top: 50%;
    left: var(--padding-md);
    transform: translateY(-50%);
  }

  /* Variant picker alignment modifiers */
  .variant-picker--center,
  .variant-picker--center .variant-option {
    text-align: center;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .variant-picker--right,
  .variant-picker--right .variant-option {
    text-align: right;
    justify-content: right;
  }

  /* Compact Pill Variant Buttons (Artic Angel style) */
  .variant-picker .variant-option + .variant-option {
    margin-top: 14px;
  }

  .variant-picker .variant-option legend,
  .variant-picker .variant-option--dropdowns > label {
    font-size: 14px;
    font-weight: 500;
    margin-bottom: 8px;
    color: var(--variant-option-label-color, var(--color-foreground, #111));
    letter-spacing: normal;
  }

  .variant-picker .variant-option--buttons,
  .variant-picker .variant-option--equal-width-buttons {
    display: flex !important;
    flex-wrap: wrap !important;
    grid-template-columns: none !important;
    gap: 10px !important;
    align-items: flex-start;
    width: 100%;
  }

  .variant-picker .variant-option__button-label {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    width: fit-content !important;
    max-width: 100% !important;
    min-width: unset !important;
    min-height: unset !important;
    height: 38px !important;
    flex: 0 0 auto !important;
    padding: 0 20px !important;
    border-radius: 9999px !important;
    font-size: var(--font-paragraph--size, 15px) !important;
    line-height: 1 !important;
    font-weight: 400 !important;
    letter-spacing: normal !important;
    cursor: pointer !important;
    box-sizing: border-box !important;
    position: relative !important;
    overflow: hidden !important;
    margin: 0 !important;
    transition: all 0.2s ease !important;
  }

  .variant-picker .variant-option__button-label__text {
    font-size: var(--font-paragraph--size, 15px) !important;
    line-height: 1 !important;
    white-space: nowrap !important;
    text-align: center !important;
    z-index: 2 !important;
  }

  /* Hide Horizon's animated sliding pill & pseudo borders */
  .variant-picker .variant-option__button-label__pill {
    display: none !important;
  }

  .variant-picker .variant-option__button-label::before,
  .variant-picker .variant-option__button-label::after {
    display: none !important;
  }

  /* Checked / Active Pill */
  .variant-picker .variant-option__button-label:has(:checked) {
    background-color: var(--color-selected-variant-background, #000000) !important;
    border: 1px solid var(--color-selected-variant-border, #000000) !important;
    color: var(--color-selected-variant-text, #ffffff) !important;
  }

  .variant-picker .variant-option__button-label:has(:checked) .variant-option__button-label__text {
    color: var(--color-selected-variant-text, #ffffff) !important;
    font-weight: 500 !important;
  }

  /* Unchecked Pill */
  .variant-picker .variant-option__button-label:not(:has(:checked)) {
    background-color: var(--color-variant-background, #ffffff) !important;
    border: 1px solid var(--color-variant-border, #222222) !important;
    color: var(--color-variant-text, #111111) !important;
  }

  .variant-picker .variant-option__button-label:not(:has(:checked)) .variant-option__button-label__text {
    color: var(--color-variant-text, #111111) !important;
  }

  .variant-picker .variant-option__button-label:not(:has(:checked)):hover {
    border-color: #000000 !important;
    background-color: #f7f7f7 !important;
  }

  /* Unavailable / Sold Out Pill */
  .variant-picker .variant-option__button-label:has([data-option-available='false']) {
    opacity: 0.6;
    background-color: #fafafa !important;
    border-color: #e0e0e0 !important;
  }

  .variant-picker .variant-option__button-label:has([data-option-available='false']) .variant-option__button-label__text {
    color: #888888 !important;
  }

  .variant-picker .variant-option__button-label svg.variant-option__strikethrough {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 3;
  }

  .variant-picker .variant-option__button-label svg.variant-option__strikethrough line {
    stroke: #888888;
    stroke-width: 1px;
  }
{% endstylesheet %}
